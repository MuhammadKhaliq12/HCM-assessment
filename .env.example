# Main API URL for the external HCM system.
HCM_API_URL=http://localhost:3001
# Shared secret/API key for outbound HCM calls.
HCM_API_KEY=readyon-dev-key
# Secret presented by managers as header `x-manager-api-key` when approving/rejecting time-off.
MANAGER_API_KEY=change-me-manager-key
# Shared secret used to validate inbound HCM webhooks (HMAC SHA-256).
HCM_WEBHOOK_SECRET=readyon-dev-webhook-secret
# Optional: where mock HCM POSTs balance drift notifications (ReadyOn /webhooks/hcm).
READYON_WEBHOOK_URL=http://localhost:3000/webhooks/hcm
# SQLite file path used by TypeORM.
DB_PATH=./data/timeoff.sqlite
# Feature flag for local development (informational for the app layer).
MOCK_HCM_ENABLED=true
# App port for the main time-off microservice.
PORT=3000
# Mock HCM: set to "false" to disable random latency/error injection (useful for demos).
MOCK_HCM_INJECT_FAILURES=true
# TypeORM logging ("true" enables SQL warnings/errors logging).
TYPEORM_LOGGING=false
